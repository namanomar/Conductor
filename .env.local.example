# Copy this file to .env.local and fill in the values you have.
# The app runs without all of them — anything missing just shows a clear
# "not configured" error in the UI for that specific feature, instead of failing silently.

# ---- Core ----
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Used for: connection settings + encrypted credentials, synced data, saved workflows, run history.
MONGODB_URI=

# 32+ character random string used to encrypt stored OAuth/API tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Secret used to sign login session cookies (accounts: username + password).
# Falls back to TOKEN_ENCRYPTION_KEY if unset, but a separate value is recommended.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OpenAI key — powers the "generate workflow from a prompt" box and the
# real root-cause hypothesis step during a run.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- GitHub OAuth (Direct connection) ----
# Create at: https://github.com/settings/developers > New OAuth App
# Authorization callback URL: {APP_BASE_URL}/api/connections/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Slack OAuth (Direct connection) ----
# Create at: https://api.slack.com/apps > your app > OAuth & Permissions
# Redirect URL: {APP_BASE_URL}/api/connections/slack/oauth/callback
# Bot token scopes needed: channels:read, channels:history, chat:write
SLACK_CLIENT_ID=  
SLACK_CLIENT_SECRET=

# ---- Jira / Atlassian OAuth (Direct connection) ----
# Create at: https://developer.atlassian.com/console/myapps/ > OAuth 2.0 (3LO) app
# Callback URL: {APP_BASE_URL}/api/connections/jira/oauth/callback
# Scopes needed: read:jira-work write:jira-work offline_access
# (Alternative: skip OAuth entirely and use an API token instead — enter your
# Atlassian site URL, email, and an API token from https://id.atlassian.com/manage-profile/security/api-tokens
# directly in the Connections UI.)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ---- PagerDuty (Direct connection) ----
# PagerDuty doesn't offer a self-serve public OAuth app, so Direct mode uses
# a REST API key instead: PagerDuty > Integrations > API Access Keys.
# (No env var needed — entered directly in the Connections UI.)
